<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ══════════════════════════════════════════════════════════
         BỘ CHUYỂN ĐỔI DÙNG CHUNG (CONVERTERS)
    ══════════════════════════════════════════════════════════ -->
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

    <!-- ══════════════════════════════════════════════════════════
         SAAS LIGHT THEME - COLOR PALETTE
    ══════════════════════════════════════════════════════════ -->

    <!-- Brand Primary (Modern Blue) -->
    <Color x:Key="PrimaryColor">#2563EB</Color>
    <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB"/>
    
    <Color x:Key="PrimaryHoverColor">#1D4ED8</Color>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#1D4ED8"/>
    
    <Color x:Key="PrimaryLightColor">#EFF6FF</Color>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="#EFF6FF"/>

    <Color x:Key="PrimaryDarkColor">#1E40AF</Color>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#1E40AF"/>

    <!-- Backgrounds & Surfaces -->
    <Color x:Key="PageBgColor">#F3F4F6</Color>
    <SolidColorBrush x:Key="PageBgBrush" Color="#F3F4F6"/>

    <Color x:Key="CardBgColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="CardBgBrush" Color="#FFFFFF"/>
    
    <Color x:Key="SidebarBgColor">#111827</Color>
    <SolidColorBrush x:Key="SidebarBgBrush" Color="#111827"/>
    
    <Color x:Key="SidebarHoverColor">#1F2937</Color>
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#1F2937"/>

    <!-- Borders & Dividers -->
    <Color x:Key="BorderColor">#E5E7EB</Color>
    <SolidColorBrush x:Key="BorderBrush" Color="#E5E7EB"/>
    
    <Color x:Key="BorderHoverColor">#D1D5DB</Color>
    <SolidColorBrush x:Key="BorderHoverBrush" Color="#D1D5DB"/>

    <!-- Text Colors -->
    <Color x:Key="TextDarkColor">#111827</Color>
    <SolidColorBrush x:Key="TextDarkBrush" Color="#111827"/>
    
    <Color x:Key="TextMutedColor">#6B7280</Color>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#6B7280"/>
    
    <Color x:Key="TextLightColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="TextLightBrush" Color="#FFFFFF"/>
    
    <Color x:Key="SidebarTextColor">#9CA3AF</Color>
    <SolidColorBrush x:Key="SidebarTextBrush" Color="#9CA3AF"/>

    <!-- Semantic / Status Colors -->
    <!-- Success -->
    <Color x:Key="SuccessColor">#10B981</Color>
    <SolidColorBrush x:Key="SuccessBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="SuccessBgBrush" Color="#D1FAE5"/>
    <SolidColorBrush x:Key="SuccessLightBrush" Color="#A7F3D0"/>
    <SolidColorBrush x:Key="SuccessBorderBrush" Color="#6EE7B7"/>
    
    <!-- Warning -->
    <Color x:Key="WarningColor">#F59E0B</Color>
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="WarningBgBrush" Color="#FEF3C7"/>
    <SolidColorBrush x:Key="WarningLightBrush" Color="#FDE68A"/>
    
    <!-- Danger/Error -->
    <Color x:Key="DangerColor">#EF4444</Color>
    <SolidColorBrush x:Key="DangerBrush" Color="#EF4444"/>
    <SolidColorBrush x:Key="DangerBgBrush" Color="#FEE2E2"/>
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#DC2626"/>
    <SolidColorBrush x:Key="DangerLightBrush" Color="#FECACA"/>
    
    <SolidColorBrush x:Key="ErrorBrush" Color="#EF4444"/>
    <SolidColorBrush x:Key="ErrorBgBrush" Color="#FEE2E2"/>
    <SolidColorBrush x:Key="ErrorBorderBrush" Color="#F87171"/>
    
    <!-- Primary Blue aliases (for resident portal views) -->
    <SolidColorBrush x:Key="PrimaryBlueBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="#BFDBFE"/>

    <!-- ══════════════════════════════════════════════════════════
         TYPOGRAPHY, SPACING & CORNER RADIUS
    ══════════════════════════════════════════════════════════ -->
    <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">8</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">12</CornerRadius>

    <!-- ══════════════════════════════════════════════════════════
         SHADOWS (ELEVATION)
    ══════════════════════════════════════════════════════════ -->
    <DropShadowEffect x:Key="ShadowSm" BlurRadius="4" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.05" />
    <DropShadowEffect x:Key="ShadowMd" BlurRadius="6" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.1" />
    <DropShadowEffect x:Key="ShadowLg" BlurRadius="15" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.1" />

</ResourceDictionary>
