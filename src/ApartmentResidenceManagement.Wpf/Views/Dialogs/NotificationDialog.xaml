<Window x:Class="ApartmentResidenceManagement.Wpf.Views.Dialogs.NotificationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ApartmentResidenceManagement.Wpf.Controls"
        Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False">
    <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12" Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,20" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Border Width="36" Height="4" CornerRadius="2" Background="#2563EB"
                        HorizontalAlignment="Left" Margin="0,0,0,12"/>
                <TextBlock x:Name="TitleText" FontSize="18" FontWeight="Bold" Foreground="#111827" TextWrapping="Wrap"/>
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <controls:NotificationBanner x:Name="Notice" MaxHeight="300"/>
                    <Expander x:Name="DetailsExpander" Header="Chi tiết kỹ thuật" Margin="0,12,0,0"
                              Visibility="Collapsed" Foreground="#6B7280">
                        <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <TextBox x:Name="DetailsText" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                                     Background="Transparent" Padding="0,8,0,0" FontSize="12"/>
                        </ScrollViewer>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
            <UniformGrid x:Name="Actions" Grid.Row="2" Rows="1" Margin="-4,16,-4,0"/>
        </Grid>
    </Border>
</Window>
