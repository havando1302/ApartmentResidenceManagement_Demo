<UserControl x:Class="ApartmentResidenceManagement.Wpf.Views.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ApartmentResidenceManagement.Wpf.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             Background="{StaticResource PageBgBrush}">

    <UserControl.Resources>
        <!-- Style cho Thẻ KPI Card -->
        <Style x:Key="KpiCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBgBrush}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20,16"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" Direction="0" ShadowDepth="0" Color="#000000" Opacity="0.04"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style cho Section Card -->
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBgBrush}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" Direction="0" ShadowDepth="0" Color="#000000" Opacity="0.04"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom ProgressBar Style -->
        <Style x:Key="StatProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="10"/>
            <Setter Property="Background" Value="#ECEFF1"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="TemplateRoot">
                            <Border CornerRadius="5" Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}"/>
                            <Border x:Name="PART_Indicator" CornerRadius="5" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút chính Admin Green -->
        <Style x:Key="AdminPrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource TextDarkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Overlay Loading State -->
        <Border Background="#CCFFFFFF" Panel.ZIndex="10" CornerRadius="0"
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="⏳" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="Đang phân tích và tổng hợp số liệu..." FontSize="14"
                           Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Main Layout Grid -->
        <Grid Margin="24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Header -->
                <RowDefinition Height="Auto"/>  <!-- Error -->
                <RowDefinition Height="Auto"/>  <!-- KPI Cards -->
                <RowDefinition Height="*"/>     <!-- Detail Section -->
            </Grid.RowDefinitions>

            <!-- 1. TIÊU ĐỀ TRANG VÀ NÚT TẢI LẠI -->
            <Grid Grid.Row="0" Margin="8,0,8,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Báo cáo thống kê chi tiết" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}"/>
                    <TextBlock Text="Phân tích tổng quan dữ liệu căn hộ, cư dân sinh sống và phương tiện đăng ký." FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                
                <Button Grid.Column="1" Content="↻  Làm mới dữ liệu" Style="{StaticResource AdminPrimaryBtn}"
                        VerticalAlignment="Center" Command="{Binding RefreshCommand}"/>
            </Grid>

            <controls:NotificationBanner Grid.Row="1" Message="{Binding ErrorMessage}"
                                         Kind="Error" Margin="8,0,8,12"/>

            <!-- 2. KPI CARDS ROW (4 CARDS) -->
            <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,12">
                
                <!-- KPI 1: CĂN HỘ -->
                <Border Style="{StaticResource KpiCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="TỔNG SỐ CĂN HỘ" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,12,0,0">
                            <TextBlock Text="{Binding TotalApartments}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}"/>
                            <TextBlock Text=" căn hộ" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="5,0,0,5" VerticalAlignment="Bottom"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- KPI 2: CƯ DÂN (Nhân khẩu) -->
                <Border Style="{StaticResource KpiCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="HỒ SƠ CƯ DÂN" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,12,0,0">
                            <TextBlock Text="{Binding TotalResidents}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                            <TextBlock Text=" nhân khẩu" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="5,0,0,5" VerticalAlignment="Bottom"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- KPI 3: ĐANG Ở THỰC TẾ (Cư trú Active) -->
                <Border Style="{StaticResource KpiCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="ĐANG CƯ TRÚ THỰC TẾ" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,12,0,0">
                            <TextBlock Text="{Binding ActiveResidentsCount}" FontSize="32" FontWeight="Bold" Foreground="#00796B"/>
                            <TextBlock Text=" người ở" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="5,0,0,5" VerticalAlignment="Bottom"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- KPI 4: PHƯƠNG TIỆN -->
                <Border Style="{StaticResource KpiCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="PHƯƠNG TIỆN ĐĂNG KÝ" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,12,0,0">
                            <TextBlock Text="{Binding TotalVehicles}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource WarningBrush}"/>
                            <TextBlock Text=" xe đăng ký" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="5,0,0,5" VerticalAlignment="Bottom"/>
                        </StackPanel>
                    </Grid>
                </Border>
                
            </UniformGrid>

            <!-- 3. DETAILED STATS AREA (3 COLUMNS) -->
            <UniformGrid Grid.Row="3" Columns="3" Margin="0,0,0,8">
                
                <!-- SECTION A: CHI TIẾT CĂN HỘ -->
                <Border Style="{StaticResource SectionCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" Text="THỐNG KÊ TRẠNG THÁI CĂN HỘ" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" Margin="0,0,0,20"/>
                        
                        <StackPanel Grid.Row="1" VerticalAlignment="Center">
                            <!-- Căn hộ Đang ở -->
                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="Đang cư trú" Foreground="{StaticResource TextDarkBrush}" FontSize="12"/>
                                <TextBlock Text="{Binding OccupiedApartments}" Foreground="{StaticResource SuccessBrush}" FontWeight="Bold" HorizontalAlignment="Right" FontSize="12"/>
                            </Grid>
                            <ProgressBar Style="{StaticResource StatProgressBar}" Value="{Binding OccupiedApartments}" Maximum="{Binding TotalApartments}" Foreground="{StaticResource SuccessBrush}" Margin="0,0,0,20"/>

                            <!-- Căn hộ Trống -->
                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="Trống" Foreground="{StaticResource TextDarkBrush}" FontSize="12"/>
                                <TextBlock Text="{Binding EmptyApartments}" Foreground="{StaticResource WarningBrush}" FontWeight="Bold" HorizontalAlignment="Right" FontSize="12"/>
                            </Grid>
                            <ProgressBar Style="{StaticResource StatProgressBar}" Value="{Binding EmptyApartments}" Maximum="{Binding TotalApartments}" Foreground="{StaticResource WarningBrush}" Margin="0,0,0,20"/>

                            <!-- Căn hộ Bảo trì -->
                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="Bảo trì / Sửa chữa" Foreground="{StaticResource TextDarkBrush}" FontSize="12"/>
                                <TextBlock Text="{Binding MaintenanceApartments}" Foreground="{StaticResource ErrorBrush}" FontWeight="Bold" HorizontalAlignment="Right" FontSize="12"/>
                            </Grid>
                            <ProgressBar Style="{StaticResource StatProgressBar}" Value="{Binding MaintenanceApartments}" Maximum="{Binding TotalApartments}" Foreground="{StaticResource ErrorBrush}" Margin="0,0,0,10"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- SECTION B: CHI TIẾT CƯ DÂN (GIỚI TÍNH) -->
                <Border Style="{StaticResource SectionCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="THỐNG KÊ CƠ CẤU GIỚI TÍNH" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" Margin="0,0,0,20"/>

                        <StackPanel Grid.Row="1" VerticalAlignment="Center">
                            <!-- Nam -->
                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="Cư dân Nam" Foreground="{StaticResource TextDarkBrush}" FontSize="12"/>
                                <TextBlock Text="{Binding MaleResidents}" Foreground="#00796B" FontWeight="Bold" HorizontalAlignment="Right" FontSize="12"/>
                            </Grid>
                            <ProgressBar Style="{StaticResource StatProgressBar}" Value="{Binding MaleResidents}" Maximum="{Binding TotalResidents}" Foreground="#00796B" Margin="0,0,0,20"/>

                            <!-- Nữ -->
                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="Cư dân Nữ" Foreground="{StaticResource TextDarkBrush}" FontSize="12"/>
                                <TextBlock Text="{Binding FemaleResidents}" Foreground="#E91E63" FontWeight="Bold" HorizontalAlignment="Right" FontSize="12"/>
                            </Grid>
                            <ProgressBar Style="{StaticResource StatProgressBar}" Value="{Binding FemaleResidents}" Maximum="{Binding TotalResidents}" Foreground="#E91E63" Margin="0,0,0,20"/>

                            <!-- Khác -->
                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="Khác" Foreground="{StaticResource TextDarkBrush}" FontSize="12"/>
                                <TextBlock Text="{Binding OtherResidents}" Foreground="{StaticResource TextMutedBrush}" FontWeight="Bold" HorizontalAlignment="Right" FontSize="12"/>
                            </Grid>
                            <ProgressBar Style="{StaticResource StatProgressBar}" Value="{Binding OtherResidents}" Maximum="{Binding TotalResidents}" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- SECTION C: CHI TIẾT PHƯƠNG TIỆN -->
                <Border Style="{StaticResource SectionCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="CƠ CẤU PHƯƠNG TIỆN ĐĂNG KÝ" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" Margin="0,0,0,20"/>

                        <StackPanel Grid.Row="1" VerticalAlignment="Center">
                            <!-- Xe máy -->
                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="🏍 Xe Máy" Foreground="{StaticResource TextDarkBrush}" FontSize="12"/>
                                <TextBlock Text="{Binding MotorbikesCount}" Foreground="#1B8A5A" FontWeight="Bold" HorizontalAlignment="Right" FontSize="12"/>
                            </Grid>
                            <ProgressBar Style="{StaticResource StatProgressBar}" Value="{Binding MotorbikesCount}" Maximum="{Binding TotalVehicles}" Foreground="#1B8A5A" Margin="0,0,0,15"/>

                            <!-- Ô tô -->
                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="🚗 Ô Tô" Foreground="{StaticResource TextDarkBrush}" FontSize="12"/>
                                <TextBlock Text="{Binding CarsCount}" Foreground="#0D47A1" FontWeight="Bold" HorizontalAlignment="Right" FontSize="12"/>
                            </Grid>
                            <ProgressBar Style="{StaticResource StatProgressBar}" Value="{Binding CarsCount}" Maximum="{Binding TotalVehicles}" Foreground="#0D47A1" Margin="0,0,0,15"/>

                            <!-- Xe đạp -->
                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="🚲 Xe Đạp" Foreground="{StaticResource TextDarkBrush}" FontSize="12"/>
                                <TextBlock Text="{Binding BicyclesCount}" Foreground="#D17A00" FontWeight="Bold" HorizontalAlignment="Right" FontSize="12"/>
                            </Grid>
                            <ProgressBar Style="{StaticResource StatProgressBar}" Value="{Binding BicyclesCount}" Maximum="{Binding TotalVehicles}" Foreground="#D17A00" Margin="0,0,0,5"/>
                        </StackPanel>
                    </Grid>
                </Border>
                
            </UniformGrid>
        </Grid>
    </Grid>
</UserControl>
