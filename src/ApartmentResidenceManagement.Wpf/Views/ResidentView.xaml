<UserControl x:Class="ApartmentResidenceManagement.Wpf.Views.ResidentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ApartmentResidenceManagement.Wpf.Behaviors"
             xmlns:controls="clr-namespace:ApartmentResidenceManagement.Wpf.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:enums="clr-namespace:ApartmentResidenceManagement.Domain.Enums;assembly=ApartmentResidenceManagement.Domain"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             Background="{StaticResource PageBgBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ===== CỘT TRÁI: DANH SÁCH ===== -->
        <Grid Grid.Column="0" Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Header -->
                <RowDefinition Height="Auto"/>  <!-- Toolbar -->
                <RowDefinition Height="Auto"/>  <!-- Error -->
                <RowDefinition Height="*"/>     <!-- DataGrid -->
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Quản lý Cư dân" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}"/>
                    <TextBlock Text="Quản lý thông tin cư dân, nhân khẩu đang cư trú trong chung cư." FontSize="14" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                
                <!-- Tổng số bản ghi -->
                <Border Grid.Column="1" CornerRadius="{StaticResource RadiusLarge}" Padding="16,8" Background="{StaticResource PrimaryLightBrush}" VerticalAlignment="Center">
                    <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryDarkBrush}">
                        <Run Text="Tổng cộng: "/>
                        <Run Text="{Binding Residents.Count, Mode=OneWay}"/>
                        <Run Text=" cư dân"/>
                    </TextBlock>
                </Border>
            </Grid>

            <!-- TOOLBAR: Search | Làm mới | Thêm -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Tìm kiếm -->
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="Tìm kiếm cư dân" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>
                        <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Height="40" Tag="Tìm kiếm theo Họ tên, CCCD hoặc Số điện thoại..."/>
                    </StackPanel>

                    <!-- Nút Làm mới -->
                    <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Bottom">
                        <Button Style="{StaticResource OutlineButton}" Content="↻ Làm mới" Height="40" Padding="16,0" Command="{Binding LoadResidentsCommand}"/>
                    </StackPanel>

                    <!-- Nút Thêm cư dân -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                        <Button Style="{StaticResource PrimaryButton}" Content="＋ Thêm cư dân" Height="40" Padding="20,0" Command="{Binding OpenAddFormCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ERROR BANNER -->
            <controls:NotificationBanner Grid.Row="2" Message="{Binding ErrorMessage}" Kind="Error" Margin="0,0,0,16">
                <controls:NotificationBanner.Style>
                    <Style TargetType="controls:NotificationBanner">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFormOpen}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsAccountPanelOpen}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </controls:NotificationBanner.Style>
            </controls:NotificationBanner>

            <!-- DATA GRID CONTAINER -->
            <Border Grid.Row="3" Style="{StaticResource CardStyle}">
                <Grid>
                    <!-- Loading State -->
                    <Border Background="{StaticResource CardBgBrush}" CornerRadius="{StaticResource RadiusMedium}" Panel.ZIndex="10" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="⏳" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                            <TextBlock Text="Đang tải dữ liệu..." FontSize="16" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Empty State -->
                    <Border Background="{StaticResource CardBgBrush}" CornerRadius="{StaticResource RadiusMedium}" Panel.ZIndex="5">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsLoading}" Value="False"/>
                                            <Condition Binding="{Binding HasError}" Value="False"/>
                                            <Condition Binding="{Binding Residents.Count}" Value="0"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="👤" FontSize="64" HorizontalAlignment="Center" Margin="0,0,0,16" Opacity="0.5"/>
                            <TextBlock Text="Chưa có cư dân nào" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextDarkBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="Hãy thêm mới cư dân hoặc làm mới bộ lọc." FontSize="14" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- DataGrid -->
                    <DataGrid behaviors:DataGridRowNumbers.IsEnabled="True" ItemsSource="{Binding Residents}" SelectedItem="{Binding SelectedResident}" Style="{StaticResource ModernDataGrid}" AutoGenerateColumns="False">
                        <DataGrid.Columns>

                            <!-- STT -->
                            <DataGridTemplateColumn Header="#" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Path=(behaviors:DataGridRowNumbers.RowNumber), RelativeSource={RelativeSource AncestorType=DataGridRow}}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Họ Tên (Căn trái, padding 12px) -->
                            <DataGridTextColumn Header="Họ và tên" Binding="{Binding FullName}" Width="1.8*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryDarkBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Ngày Sinh (Căn giữa) -->
                            <DataGridTextColumn Header="Ngày sinh" Binding="{Binding DateOfBirth, StringFormat={}{0:dd/MM/yyyy}}" Width="1.2*"/>

                            <!-- Giới Tính (Căn giữa) -->
                            <DataGridTemplateColumn Header="Giới tính" Width="1.1*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Gender}" Value="{x:Static enums:GenderType.Male}">
                                                            <Setter Property="Text" Value="Nam"/>
                                                            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Gender}" Value="{x:Static enums:GenderType.Female}">
                                                            <Setter Property="Text" Value="Nữ"/>
                                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Gender}" Value="{x:Static enums:GenderType.Other}">
                                                            <Setter Property="Text" Value="Khác"/>
                                                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- CCCD/CMND (Căn giữa) -->
                            <DataGridTextColumn Header="CCCD/CMND" Binding="{Binding IdentityCard}" Width="1.5*"/>

                            <!-- Số Điện Thoại (Căn giữa) -->
                            <DataGridTextColumn Header="Số điện thoại" Binding="{Binding PhoneNumber}" Width="1.4*"/>

                            <!-- Thao tác (Căn giữa) -->
                            <DataGridTemplateColumn Header="Thao tác" Width="260">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Button Content="Sửa" Style="{StaticResource OutlineButton}" Foreground="{StaticResource WarningBrush}" BorderBrush="{StaticResource WarningLightBrush}" Background="Transparent" Margin="0,0,8,0" Padding="12,4" Command="{Binding DataContext.OpenEditFormCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                            <Button Content="Tài khoản" Style="{StaticResource OutlineButton}" Foreground="{StaticResource PrimaryBrush}" BorderBrush="{StaticResource PrimaryLightBrush}" Background="Transparent" Margin="0,0,8,0" Padding="12,4" Command="{Binding DataContext.OpenAccountPanelCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                            <Button Content="Xóa" Style="{StaticResource OutlineButton}" Foreground="{StaticResource DangerBrush}" BorderBrush="{StaticResource DangerLightBrush}" Background="Transparent" Padding="12,4" Command="{Binding DataContext.DeleteResidentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== FORM HỒ SƠ MODAL OVERLAY ===== -->
        <Grid Grid.Column="0" Grid.ColumnSpan="2" Panel.ZIndex="200" Visibility="{Binding IsFormOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="#80000000">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CancelFormCommand}"/>
                </Border.InputBindings>
            </Border>

            <Border MaxWidth="480" Margin="16" MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}}"
                    Background="{StaticResource CardBgBrush}" CornerRadius="{StaticResource RadiusLarge}" Padding="24" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" Direction="270" ShadowDepth="10" Color="#000000" Opacity="0.15"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,24">
                        <TextBlock Text="{Binding FormTitle}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="Vui lòng điền các thông tin dưới đây" FontSize="14" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="500">
                        <StackPanel Margin="0,0,0,8">
                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Text="Họ và tên" FontSize="14" FontWeight="Medium" Foreground="{StaticResource TextDarkBrush}" Margin="0,0,0,8"/>
                                <TextBox Style="{StaticResource ModernTextBox}" Height="42" Text="{Binding EditingResident.FullName, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Text="Ngày sinh" FontSize="14" FontWeight="Medium" Foreground="{StaticResource TextDarkBrush}" Margin="0,0,0,8"/>
                                <DatePicker SelectedDate="{Binding EditingResident.DateOfBirth}" Height="42" FontSize="14" Background="White" BorderBrush="{StaticResource BorderBrush}"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Text="Giới tính" FontSize="14" FontWeight="Medium" Foreground="{StaticResource TextDarkBrush}" Margin="0,0,0,8"/>
                                <ComboBox Style="{StaticResource ModernComboBox}" Height="42" ItemsSource="{Binding GenderOptions}" SelectedItem="{Binding EditingResident.Gender}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding}" Value="{x:Static enums:GenderType.Male}">
                                                                <Setter Property="Text" Value="Nam"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding}" Value="{x:Static enums:GenderType.Female}">
                                                                <Setter Property="Text" Value="Nữ"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding}" Value="{x:Static enums:GenderType.Other}">
                                                                <Setter Property="Text" Value="Khác"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Text="CCCD/CMND" FontSize="14" FontWeight="Medium" Foreground="{StaticResource TextDarkBrush}" Margin="0,0,0,8"/>
                                <TextBox Style="{StaticResource ModernTextBox}" Height="42" Text="{Binding EditingResident.IdentityCard, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Text="Số điện thoại" FontSize="14" FontWeight="Medium" Foreground="{StaticResource TextDarkBrush}" Margin="0,0,0,8"/>
                                <TextBox Style="{StaticResource ModernTextBox}" Height="42" Text="{Binding EditingResident.PhoneNumber, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Text="Quê quán / HKTT" FontSize="14" FontWeight="Medium" Foreground="{StaticResource TextDarkBrush}" Margin="0,0,0,8"/>
                                <TextBox Style="{StaticResource ModernTextBox}" Height="42" Text="{Binding EditingResident.HomeTown, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <controls:NotificationBanner Grid.Row="2" Message="{Binding ErrorMessage}" Kind="Error" Margin="0,12,0,0"/>

                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Hủy" Style="{StaticResource OutlineButton}" Height="44" Command="{Binding CancelFormCommand}"/>
                        <Button Grid.Column="2" Content="Lưu thông tin" Style="{StaticResource PrimaryButton}" Height="44" Command="{Binding SaveResidentCommand}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== QUẢN LÝ TÀI KHOẢN MODAL OVERLAY ===== -->
        <Grid Grid.Column="0" Grid.ColumnSpan="2" Panel.ZIndex="210" Visibility="{Binding IsAccountPanelOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="#80000000">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CloseAccountPanelCommand}"/>
                </Border.InputBindings>
            </Border>

            <Border MaxWidth="480" Margin="16" MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}}"
                    Background="{StaticResource CardBgBrush}" CornerRadius="{StaticResource RadiusLarge}" Padding="24" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" Direction="270" ShadowDepth="10" Color="#000000" Opacity="0.15"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,24">
                        <TextBlock Text="Tài khoản đăng nhập" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" TextWrapping="Wrap"/>
                        <TextBlock FontSize="14" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap">
                            <Run Text="Cư dân: "/>
                            <Run Text="{Binding SelectedResident.FullName}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryDarkBrush}"/>
                        </TextBlock>
                    </StackPanel>

                    <!-- Body -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="500">
                    <StackPanel>
                        <!-- Trạng thái hiện tại -->
                        <Border Background="{StaticResource PageBgBrush}" CornerRadius="{StaticResource RadiusMedium}" Padding="16" Margin="0,0,0,24">
                            <StackPanel>
                                <TextBlock Text="Trạng thái tài khoản:" Foreground="{StaticResource TextMutedBrush}" FontSize="14" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding AccountStatusText}" FontWeight="Bold" FontSize="14" Margin="0,6,0,0" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedResidentHasAccount}" Value="False">
                                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding AccountStatusText}" Value="ĐANG HOẠT ĐỘNG">
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding AccountStatusText}" Value="ĐÃ BỊ KHÓA">
                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- CASE 1: Cư dân CHƯA có tài khoản (Hiển thị Form Cấp tài khoản) -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedResidentHasAccount}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            
                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Text="Tên đăng nhập" FontSize="14" FontWeight="Medium" Foreground="{StaticResource TextDarkBrush}" Margin="0,0,0,8"/>
                                <TextBox Style="{StaticResource ModernTextBox}" Height="42" Text="{Binding AccountUsername, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,24">
                                <TextBlock Text="Mật khẩu khởi tạo (Từ 6 ký tự)" FontSize="14" FontWeight="Medium" Foreground="{StaticResource TextDarkBrush}" Margin="0,0,0,8"/>
                                <TextBox Style="{StaticResource ModernTextBox}" Height="42" Text="{Binding AccountPassword, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                        </StackPanel>

                        <!-- CASE 2: Cư dân ĐÃ có tài khoản -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedResidentHasAccount}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Username liên kết:" Foreground="{StaticResource TextDarkBrush}" FontSize="14" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding AccountUsername}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryDarkBrush}" FontSize="14" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    </ScrollViewer>

                    <controls:NotificationBanner Grid.Row="2" Message="{Binding ErrorMessage}" Kind="Error" Margin="0,12,0,0"/>

                    <!-- Footer -->
                    <StackPanel Grid.Row="3" Margin="0,12,0,0">
                        <Button Content="Cấp tài khoản mới" Height="44" Command="{Binding CreateAccountCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedResidentHasAccount}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Đổi trạng thái (Mở / Khóa)" Style="{StaticResource PrimaryButton}" Height="44"
                                Visibility="{Binding SelectedResidentHasAccount, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Command="{Binding ToggleAccountStatusCommand}"/>
                        <Button Content="Đóng" Style="{StaticResource OutlineButton}" Height="44" Margin="0,12,0,0" Command="{Binding CloseAccountPanelCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
