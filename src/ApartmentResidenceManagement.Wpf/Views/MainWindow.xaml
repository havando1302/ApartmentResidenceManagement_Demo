<Window x:Class="ApartmentResidenceManagement.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:ApartmentResidenceManagement.Wpf.ViewModels"
        xmlns:views="clr-namespace:ApartmentResidenceManagement.Wpf.Views"
        mc:Ignorable="d"
        Title="Hệ thống Quản lý Cư trú - RMS"
        Height="768" Width="1366"
        MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBgBrush}">

    <Window.Resources>
        <!-- DataTemplate mapping -->
        <DataTemplate DataType="{x:Type viewModels:DashboardViewModel}"><views:DashboardView /></DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ApartmentViewModel}"><views:ApartmentView /></DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ResidentViewModel}"><views:ResidentView /></DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ResidencyViewModel}"><views:ResidencyView /></DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:VehicleViewModel}"><views:VehicleView /></DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:StatisticsViewModel}"><views:StatisticsView /></DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ResidentHomeViewModel}"><views:ResidentHomeView /></DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:MyProfileViewModel}"><views:MyProfileView /></DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:MyApartmentViewModel}"><views:MyApartmentView /></DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:FamilyMembersViewModel}"><views:FamilyMembersView /></DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:MyVehiclesViewModel}"><views:MyVehiclesView /></DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ResidencyHistoryViewModel}"><views:ResidencyHistoryView /></DataTemplate>

        <!-- Sidebar Base Button -->
        <Style x:Key="SidebarBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource SidebarTextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="12,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="{StaticResource RadiusMedium}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SidebarHoverBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextLightBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Active Sidebar Button Trigger logic applied per button below -->
        
        <!-- Logout Button -->
        <Style x:Key="LogoutButton" TargetType="Button" BasedOn="{StaticResource SidebarBtn}">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="{StaticResource RadiusMedium}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#311111"/>
                                <Setter Property="Foreground" Value="{StaticResource DangerHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBgBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Row="0" Margin="24,24,24,32" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="{StaticResource RadiusSmall}" Background="{StaticResource PrimaryBrush}" Margin="0,0,12,0">
                        <TextBlock Text="R" Foreground="White" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="RMS" FontSize="20" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="Quản lý cư trú" FontSize="12" Foreground="{StaticResource SidebarTextBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- User Info -->
                <Border Grid.Row="1" Margin="16,0,16,24" Background="{StaticResource SidebarHoverBrush}" CornerRadius="{StaticResource RadiusMedium}" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="#374151" Margin="0,0,12,0">
                            <TextBlock Text="U" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding WelcomeMessage}" FontSize="14" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding RoleMessage}" FontSize="12" Foreground="{StaticResource PrimaryLightBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Navigation -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- ADMIN MENU -->
                        <StackPanel Visibility="{Binding IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="MENU QUẢN LÝ" FontSize="11" FontWeight="Bold" Foreground="#6B7280" Margin="24,8,0,8" />
                            
                            <!-- Dashboard -->
                            <Button Command="{Binding ShowDashboardCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarBtn}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveTab}" Value="DashboardViewModel">
                                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📊" Margin="0,0,12,0" FontSize="16"/>
                                    <TextBlock Text="Tổng quan"/>
                                </StackPanel>
                            </Button>

                            <!-- Apartment -->
                            <Button Command="{Binding ShowApartmentCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarBtn}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveTab}" Value="ApartmentViewModel">
                                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🏢" Margin="0,0,12,0" FontSize="16"/>
                                    <TextBlock Text="Căn hộ"/>
                                </StackPanel>
                            </Button>

                            <!-- Resident -->
                            <Button Command="{Binding ShowResidentCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarBtn}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveTab}" Value="ResidentViewModel">
                                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="👥" Margin="0,0,12,0" FontSize="16"/>
                                    <TextBlock Text="Cư dân"/>
                                </StackPanel>
                            </Button>

                            <!-- Residency -->
                            <Button Command="{Binding ShowResidencyCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarBtn}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveTab}" Value="ResidencyViewModel">
                                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📝" Margin="0,0,12,0" FontSize="16"/>
                                    <TextBlock Text="Quản lý cư trú"/>
                                </StackPanel>
                            </Button>

                            <!-- Vehicle -->
                            <Button Command="{Binding ShowVehicleCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarBtn}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveTab}" Value="VehicleViewModel">
                                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🚗" Margin="0,0,12,0" FontSize="16"/>
                                    <TextBlock Text="Phương tiện"/>
                                </StackPanel>
                            </Button>
                            
                            <!-- Statistics -->
                            <Button Command="{Binding ShowStatisticsCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarBtn}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveTab}" Value="StatisticsViewModel">
                                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📈" Margin="0,0,12,0" FontSize="16"/>
                                    <TextBlock Text="Thống kê"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- RESIDENT MENU -->
                        <StackPanel Visibility="{Binding IsResident, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="CỔNG CƯ DÂN" FontSize="11" FontWeight="Bold" Foreground="#6B7280" Margin="24,8,0,8" />
                            
                            <!-- Home -->
                            <Button Command="{Binding ShowResidentHomeCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarBtn}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveTab}" Value="ResidentHomeViewModel">
                                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🏠" Margin="0,0,12,0" FontSize="16"/>
                                    <TextBlock Text="Trang chủ"/>
                                </StackPanel>
                            </Button>

                            <!-- Profile -->
                            <Button Command="{Binding ShowMyProfileCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarBtn}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveTab}" Value="MyProfileViewModel">
                                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="👤" Margin="0,0,12,0" FontSize="16"/>
                                    <TextBlock Text="Hồ sơ cá nhân"/>
                                </StackPanel>
                            </Button>

                            <!-- My Apartment -->
                            <Button Command="{Binding ShowMyApartmentCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarBtn}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveTab}" Value="MyApartmentViewModel">
                                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🏢" Margin="0,0,12,0" FontSize="16"/>
                                    <TextBlock Text="Căn hộ của tôi"/>
                                </StackPanel>
                            </Button>

                            <!-- Family -->
                            <Button Command="{Binding ShowFamilyMembersCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarBtn}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveTab}" Value="FamilyMembersViewModel">
                                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="👨‍👩‍👧‍👦" Margin="0,0,12,0" FontSize="16"/>
                                    <TextBlock Text="Hộ gia đình"/>
                                </StackPanel>
                            </Button>

                            <!-- Vehicles -->
                            <Button Command="{Binding ShowMyVehiclesCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarBtn}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveTab}" Value="MyVehiclesViewModel">
                                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🚗" Margin="0,0,12,0" FontSize="16"/>
                                    <TextBlock Text="Phương tiện"/>
                                </StackPanel>
                            </Button>

                            <!-- History -->
                            <Button Command="{Binding ShowResidencyHistoryCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarBtn}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveTab}" Value="ResidencyHistoryViewModel">
                                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🕒" Margin="0,0,12,0" FontSize="16"/>
                                    <TextBlock Text="Lịch sử"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Logout -->
                <Button Grid.Row="3" Command="{Binding LogoutCommand}" Style="{StaticResource SidebarBtn}" Foreground="{StaticResource DangerBrush}" Margin="24">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🚪" Margin="0,0,12,0" FontSize="16"/>
                        <TextBlock Text="Đăng xuất"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- MAIN CONTENT (Right) -->
        <Grid Grid.Column="1" Background="{StaticResource PageBgBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="72"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Topbar -->
            <Border Grid.Row="0" Background="White" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderBrush}">
                <Grid Margin="32,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding WelcomeMessage}" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextDarkBrush}"/>
                        <TextBlock Text="{Binding RoleMessage}" FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <TextBlock Text="RMS v1.0" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
            </Border>

            <!-- Dynamic Content -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}"/>
        </Grid>
    </Grid>
</Window>
