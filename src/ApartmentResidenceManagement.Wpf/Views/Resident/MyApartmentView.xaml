<UserControl x:Class="ApartmentResidenceManagement.Wpf.Views.MyApartmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ApartmentResidenceManagement.Wpf.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="950"
             Background="{StaticResource PageBgBrush}">

    <UserControl.Resources>
        <!-- Apartment Card Style -->
        <Style x:Key="ApartmentCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBgBrush}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" Direction="0" ShadowDepth="0" Color="#000000" Opacity="0.04"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nhãn tiêu đề trường thông tin -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <!-- Giá trị trường thông tin -->
        <Style x:Key="ValueLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextDarkBrush}"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="*"/>     <!-- Nội dung -->
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Grid.Row="0" Margin="12,0,12,16">
            <TextBlock Text="Căn hộ của tôi" FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource PrimaryDarkBrush}"/>
            <TextBlock Text="Thông tin căn hộ và hợp đồng cư trú hiện tại của bạn tại tòa nhà."
                       FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- NỘI DUNG CHÍNH -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
        <Grid>
            
            <!-- TH1: CHƯA CÓ CĂN HỘ -->
            <Border Background="{StaticResource CardBgBrush}" CornerRadius="10" Padding="40" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="500">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasApartment}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" Direction="0" ShadowDepth="0" Color="#000000" Opacity="0.04"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="⚠️" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                    <TextBlock Text="Chưa có căn hộ đăng ký" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="Tài khoản của bạn hiện tại chưa được Ban Quản Lý liên kết với căn hộ nào trong tòa nhà. Vui lòng liên hệ Văn Phòng Ban Quản Lý để được đăng ký cư trú." 
                               FontSize="14" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" TextAlignment="Center" LineHeight="20"/>
                </StackPanel>
            </Border>

            <!-- TH2: ĐÃ CÓ CĂN HỘ -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasApartment}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Cột trái: Thông tin Căn hộ -->
                <Border Grid.Column="0" Style="{StaticResource ApartmentCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <StackPanel Grid.Row="0" Margin="0,0,0,20">
                            <TextBlock Text="THÔNG TIN CĂN HỘ" FontSize="15" FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBlueBrush}"/>
                            <Border Height="2" Width="40" Background="{StaticResource PrimaryBlueBrush}"
                                    HorizontalAlignment="Left" Margin="0,6,0,0"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Row="1" VerticalAlignment="Center">
                            <!-- Số căn hộ -->
                            <TextBlock Text="Số căn hộ" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <TextBlock Text="🚪" FontSize="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding ApartmentNumber}" FontSize="26" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryDarkBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Số tầng -->
                            <TextBlock Text="Vị trí tầng" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <TextBlock Text="🏢" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding FloorText}" Style="{StaticResource ValueLabel}" Margin="0"/>
                            </StackPanel>

                            <!-- Diện tích -->
                            <TextBlock Text="Diện tích sử dụng" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <TextBlock Text="📐" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding AreaText}" Style="{StaticResource ValueLabel}" Margin="0"/>
                            </StackPanel>

                            <!-- Trạng thái -->
                            <TextBlock Text="Trạng thái căn hộ" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🛡" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Border Background="#E8F5E9" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ApartmentStatusText}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource SuccessBrush}"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Cột phải: Thông tin Hợp đồng / Cư trú -->
                <Border Grid.Column="1" Style="{StaticResource ApartmentCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,20">
                            <TextBlock Text="HỢP ĐỒNG CƯ TRÚ" FontSize="15" FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBlueBrush}"/>
                            <Border Height="2" Width="40" Background="{StaticResource PrimaryBlueBrush}"
                                    HorizontalAlignment="Left" Margin="0,6,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" VerticalAlignment="Center">
                            <!-- Quan hệ cư trú -->
                            <TextBlock Text="Vai trò / Quan hệ cư trú" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <TextBlock Text="🔑" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Border Background="#E3F2FD" CornerRadius="4" Padding="10,4" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding RelationshipText}" FontSize="13" FontWeight="Bold"
                                               Foreground="{StaticResource PrimaryDarkBrush}"/>
                                </Border>
                            </StackPanel>

                            <!-- Ngày bắt đầu -->
                            <TextBlock Text="Ngày bắt đầu cư trú" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <TextBlock Text="📅" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding StartDateText}" Style="{StaticResource ValueLabel}" Margin="0"/>
                            </StackPanel>

                            <!-- Trạng thái cư trú -->
                            <TextBlock Text="Trạng thái hợp đồng" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <TextBlock Text="🟢" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Đang hoạt động" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Ghi chú lưu ý -->
                            <controls:NotificationBanner Kind="Information" Margin="0,10,0,0"
                                                         Message="Nếu có thay đổi nhân khẩu hoặc đăng ký xe mới, vui lòng khai báo bổ sung ở các phân mục tương ứng hoặc liên hệ Ban Quản Lý."/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

        </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
